        <view contentMode="scaleToFill" id="csv-root" userLabel="CustomStepperView Content">
            <rect key="frame" x="0.0" y="0.0" width="112" height="32"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <stackView opaque="NO" contentMode="scaleToFill" alignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="csv-stack">
